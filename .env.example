# База данных. Локально по умолчанию SQLite, в проде — строка подключения Neon Postgres.
DATABASE_URL=sqlite:///./crm.db

# Вход в CRM
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-long-random-string

# Telegram-бот (токен от @BotFather)
BOT_TOKEN=
# Секрет, которым Telegram подписывает запросы на webhook (любая строка A-Z, a-z, 0-9, _ и -)
WEBHOOK_SECRET=replace-with-random-string
# Код, по которому менеджер подписывается на уведомления: /manager <код>
MANAGER_CODE=agency2026

# Публичный адрес CRM — для ссылок в уведомлениях и установки webhook
PUBLIC_URL=http://localhost:8000

# Часовой пояс для отображения дат
APP_TZ=Europe/Moscow
